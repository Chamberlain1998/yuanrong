# syntax=docker/dockerfile:1

# Dedicated builder for the standalone rrt-runtime binary and its Python wheel.
# Keep this image independent from the C++ FunctionSystem/SDK builder so each
# architecture can pin its own Rust toolchain and native compiler.
# Preinstall the native musl target and ELF inspection tools required by the
# shared RRT release-build gate.
ARG RUST_IMAGE=rust:1.85.1-bullseye
FROM ${RUST_IMAGE}

ARG SCCACHE_VERSION=0.8.2
ARG TARGETARCH

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        g++ \
        gcc \
        git \
        pkg-config \
        protobuf-compiler \
        python3 \
        python3-pip \
        python3-packaging \
        python3-setuptools \
        python3-venv \
        python3-wheel; \
    rm -rf /var/lib/apt/lists/*; \
    case "${TARGETARCH}" in \
        arm64) rrt_target=aarch64-unknown-linux-musl ;; \
        amd64) rrt_target=x86_64-unknown-linux-musl ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    rustup target add "${rrt_target}"; \
    rustc --version; \
    cargo --version; \
    cc --version | head -n 1; \
    readelf --version | head -n 1; \
    protoc --version; \
    python3 -c 'import packaging, setuptools, wheel'

# Use the same sparse Cargo mirror as the existing architecture-specific Rust
# builders. Install sccache in the image so CI never has to bootstrap it from
# GitHub/crates.io before the actual RRT build.
RUN set -eux; \
    mkdir -p "${CARGO_HOME}"; \
    printf '%s\n' \
        '[source.crates-io]' \
        'replace-with = "rsproxy-sparse"' \
        '' \
        '[source.rsproxy-sparse]' \
        'registry = "sparse+https://rsproxy.cn/index/"' \
        > "${CARGO_HOME}/config.toml"; \
    case "${TARGETARCH}" in \
        arm64) sccache_arch=aarch64 ;; \
        amd64) sccache_arch=x86_64 ;; \
        *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    sccache_pkg="sccache-v${SCCACHE_VERSION}-${sccache_arch}-unknown-linux-musl"; \
    curl -fsSL --retry 5 --retry-all-errors --connect-timeout 10 --max-time 180 \
        "https://github.com/mozilla/sccache/releases/download/v${SCCACHE_VERSION}/${sccache_pkg}.tar.gz" \
        -o /tmp/sccache.tgz; \
    tar -xzf /tmp/sccache.tgz -C /tmp; \
    install -m 0755 "/tmp/${sccache_pkg}/sccache" /usr/local/bin/sccache; \
    sccache --version

LABEL org.opencontainers.image.title="openyuanrong-rrt-rust-builder" \
      org.opencontainers.image.description="Architecture-specific Rust builder for openYuanRong RRT"

WORKDIR /workspace
